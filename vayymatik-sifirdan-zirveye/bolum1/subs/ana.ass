Dialogue: 0,0:00:03.35,0:00:07.21,N,,0,0,0,,Bir yıl önce, bu dükkânın camında\N“Devren Satılık” yazıyordu.
Dialogue: 0,0:00:07.78,0:00:09.92,K,,0,0,0,,Emir Bey... Lafı uzatmayacağım.
Dialogue: 0,0:00:10.47,0:00:13.73,K,,0,0,0,,Bu dükkân için sana 2,5\Nmilyon lira teklif ediyorum.
Dialogue: 0,0:00:14.78,0:00:19.31,N,,0,0,0,,2,5 milyon lira. Bir yıl önce cebinde\Nyalnızca 85.000 lira olan biri için...
Dialogue: 0,0:00:19.35,0:00:20.90,N,,0,0,0,,inanılmaz bir rakam.
Dialogue: 0,0:00:21.37,0:00:22.83,K,,0,0,0,,Nakit. Bu hafta. Düşün...
Dialogue: 0,0:00:22.87,0:00:24.47,K,,0,0,0,,ama çok düşünme.
Dialogue: 0,0:00:25.14,0:00:26.34,N,,0,0,0,,Emir cevap vermedi.
Dialogue: 0,0:00:26.38,0:00:29.92,N,,0,0,0,,Çünkü bu rakamın arkasında,\Nkimsenin görmediği bir hesap vardı.
Dialogue: 0,0:00:35.79,0:00:38.30,N,,0,0,0,,On iki ay önce. Emir\Nyirmi dört yaşındaydı.
Dialogue: 0,0:00:38.34,0:00:40.95,N,,0,0,0,,İşsizdi ve ailesinin yanında yaşıyordu.
Dialogue: 0,0:00:41.43,0:00:43.95,N,,0,0,0,,Gittiği her iş görüşmesi\Naynı cümleyle bitiyordu:
Dialogue: 0,0:00:43.99,0:00:45.35,N,,0,0,0,,Sizi ararız.
Dialogue: 0,0:00:45.84,0:00:46.79,N,,0,0,0,,Hiçbiri aramadı.
Dialogue: 0,0:00:47.44,0:00:49.08,N,,0,0,0,,Ama Emir'in bir hayali vardı.
Dialogue: 0,0:00:49.12,0:00:50.74,N,,0,0,0,,Kendi işini kurmak.
Dialogue: 0,0:00:51.29,0:00:53.05,N,,0,0,0,,Babası emekli bir tornacıydı.
Dialogue: 0,0:00:53.09,0:00:54.81,N,,0,0,0,,Her akşam aynı cümleyi kurardı:
Dialogue: 0,0:00:54.85,0:00:57.07,N,,0,0,0,,Garanti bir iş bul oğlum, garanti.
Dialogue: 0,0:00:57.54,0:01:00.39,N,,0,0,0,,Yıllardır kuruş kuruş\Nbiriktirdiği 85.000 lira,
Dialogue: 0,0:01:00.43,0:01:02.54,N,,0,0,0,,hesabındaki tek güvencesiydi.
Dialogue: 0,0:01:06.21,0:01:09.61,N,,0,0,0,,Bir akşam çarşıda yürürken, camında\Ndevren satılık yazan küçük bir
Dialogue: 0,0:01:09.65,0:01:11.19,N,,0,0,0,,kuyumcu gördü.
Dialogue: 0,0:01:11.84,0:01:14.70,K,,0,0,0,,Kırk yıl bu tezgâhın\Narkasında durdum evladım.
Dialogue: 0,0:01:14.74,0:01:16.46,K,,0,0,0,,Artık yoruldum.
Dialogue: 0,0:01:16.91,0:01:19.75,K,,0,0,0,,660 bine devrederim.
Dialogue: 0,0:01:20.40,0:01:23.88,K,,0,0,0,,660 bin mi? Benim 85.000 var...
Dialogue: 0,0:01:24.27,0:01:28.87,K,,0,0,0,,300 peşin verirsen, kalanını\Naltı ay taksitle konuşuruz.
Dialogue: 0,0:01:29.64,0:01:31.30,K,,0,0,0,,Usta, ben bu işi bilmiyorum.
Dialogue: 0,0:01:31.34,0:01:32.51,K,,0,0,0,,Ama öğrenirim.
Dialogue: 0,0:01:32.98,0:01:35.00,K,,0,0,0,,Devirden sonra iki hafta yanında dururum.
Dialogue: 0,0:01:35.04,0:01:37.01,K,,0,0,0,,Ayarı, gramı, işçiliği öğretirim.
Dialogue: 0,0:01:37.66,0:01:39.22,N,,0,0,0,,Emir o gece uyuyamadı.
Dialogue: 0,0:01:39.26,0:01:42.88,N,,0,0,0,,Kâğıda rakamlar yazdı,\Nsildi, yeniden yazdı.
Dialogue: 0,0:01:43.40,0:01:46.70,N,,0,0,0,,Ertesi sabah en sevdiği\Nşeyi, arabasını sattı.
Dialogue: 0,0:01:46.74,0:01:48.04,N,,0,0,0,,230.000 lira.
Dialogue: 0,0:01:49.22,0:01:52.06,N,,0,0,0,,Sonra çocukluk arkadaşı Kerem'i aradı.
Dialogue: 0,0:01:52.51,0:01:54.01,K,,0,0,0,,Sana güveniyorum kardeşim.
Dialogue: 0,0:01:54.05,0:01:57.83,K,,0,0,0,,180.000 Ama bir yıl içinde bana\Nlazım olacak, haberin olsun.
Dialogue: 0,0:01:58.40,0:02:01.62,N,,0,0,0,,Geriye en zor konuşma kalmıştı.
Dialogue: 0,0:02:01.99,0:02:04.81,K,,0,0,0,,Araban gitti, şimdi de borç mu istiyorsun?
Dialogue: 0,0:02:04.85,0:02:07.01,K,,0,0,0,,Sen altın işinden ne anlarsın?
Dialogue: 0,0:02:07.38,0:02:10.14,K,,0,0,0,,Baba... denemezsem bir ömür pişman olurum.
Dialogue: 0,0:02:10.92,0:02:12.14,N,,0,0,0,,Annesi araya girdi.
Dialogue: 0,0:02:12.18,0:02:13.65,N,,0,0,0,,Babası uzun süre sustu.
Dialogue: 0,0:02:13.69,0:02:16.76,N,,0,0,0,,Ertesi sabah, 80.000\Nlirayı masaya bıraktı.
Dialogue: 0,0:02:17.36,0:02:19.58,N,,0,0,0,,Toplam kaynak: 575.000 lira.
Dialogue: 0,0:02:19.62,0:02:23.88,N,,0,0,0,,Ama bunun neredeyse yarısı,\N260.000 lirası borçtu.
Dialogue: 0,0:02:25.35,0:02:27.48,N,,0,0,0,,Devir bedeli 660.000 liraydı.
Dialogue: 0,0:02:27.52,0:02:30.21,N,,0,0,0,,Emir 300.000 lirayı peşin ödedi.
Dialogue: 0,0:02:30.58,0:02:34.50,N,,0,0,0,,Kalan 360.000 lira, altı ay\Nboyunca ayda 60.000 lira taksitle
Dialogue: 0,0:02:34.54,0:02:37.64,N,,0,0,0,,ödenmek üzere satıcıya\Nborç olarak yazıldı.
Dialogue: 0,0:02:38.12,0:02:40.61,N,,0,0,0,,Ama devir bedeli, tek masraf değildi.
Dialogue: 0,0:02:43.66,0:02:48.40,N,,0,0,0,,Güvenlik ve ekipman 95.000 Kira ve\Ndepozito 75.000 Tadilat ve tabela
Dialogue: 0,0:02:48.44,0:02:51.02,N,,0,0,0,,55.000 Tedarikçi teminatı 32.000
Dialogue: 0,0:02:51.51,0:02:52.99,N,,0,0,0,,Hasan Usta sözünü tuttu.
Dialogue: 0,0:02:53.03,0:02:55.92,N,,0,0,0,,İki hafta boyunca her sabah dükkâna geldi.
Dialogue: 0,0:02:56.39,0:02:58.22,K,,0,0,0,,Altının fiyatını gram belirler evladım.
Dialogue: 0,0:02:58.26,0:03:00.42,K,,0,0,0,,Ama müşteriyi geri getiren, işçiliktir.
Dialogue: 0,0:03:03.67,0:03:05.88,N,,0,0,0,,Kepengi kaldırdığında elleri titriyordu.
Dialogue: 0,0:03:05.92,0:03:08.19,N,,0,0,0,,Tabelada artık kendi adı yazıyordu.
Dialogue: 0,0:03:08.66,0:03:11.56,N,,0,0,0,,Açılış sabahı kasada\Nyalnızca 18.000 lira vardı.
Dialogue: 0,0:03:11.60,0:03:13.95,N,,0,0,0,,Toplam borcu ise 620.000 liraydı.
Dialogue: 0,0:03:14.71,0:03:17.57,N,,0,0,0,,Vitrindeki altınların çoğu\Nda aslında Emir'in değildi.
Dialogue: 0,0:03:17.61,0:03:19.05,N,,0,0,0,,Tedarikçinin emanetiydi.
Dialogue: 0,0:03:19.09,0:03:21.29,N,,0,0,0,,Satılınca bedeli tedarikçiye ödenecekti.
Dialogue: 0,0:03:21.89,0:03:24.40,N,,0,0,0,,Karşılığında 32.000 lira teminat vermişti.
Dialogue: 0,0:03:24.44,0:03:28.60,N,,0,0,0,,Satılan her ürünün bedelini ise\Nbir ay içinde ödemek zorundaydı.
Dialogue: 0,0:03:29.25,0:03:30.89,N,,0,0,0,,İlk saatler sessiz geçti.
Dialogue: 0,0:03:30.93,0:03:34.37,N,,0,0,0,,Önünden geçenler vitrine\Nbakıyor, ama içeri girmiyordu.
Dialogue: 0,0:03:34.97,0:03:36.37,N,,0,0,0,,Öğleye doğru babası geldi.
Dialogue: 0,0:03:36.41,0:03:39.38,N,,0,0,0,,Hiçbir şey söylemeden\Nvitrinlere uzun uzun baktı.
Dialogue: 0,0:03:39.95,0:03:41.03,K,,0,0,0,,Hayırlı olsun oğlum.
Dialogue: 0,0:03:41.07,0:03:42.82,K,,0,0,0,,Ama unutma; borç, borçtur.
Dialogue: 0,0:03:43.57,0:03:45.95,N,,0,0,0,,İlk müşteri öğleden sonra geldi.
Dialogue: 0,0:03:46.23,0:03:48.21,K,,0,0,0,,Kızıma bir bilezik bakıyorum.
Dialogue: 0,0:03:48.48,0:03:50.88,K,,0,0,0,,Şu yirmi iki ayar burgu\Nbilezik çok yakışır.
Dialogue: 0,0:03:50.92,0:03:52.12,K,,0,0,0,,40.000 lira.
Dialogue: 0,0:03:52.77,0:03:54.16,N,,0,0,0,,Kasaya 40.000 lira girdi.
Dialogue: 0,0:03:54.20,0:03:56.25,N,,0,0,0,,Emir'in kalbi hızla çarpıyordu.
Dialogue: 0,0:03:56.61,0:03:59.39,N,,0,0,0,,Ama bu kırk binin tamamı kâr değildi.
Dialogue: 0,0:03:59.43,0:04:03.21,N,,0,0,0,,Bileziğin tedarikçiye\Nmaliyeti 35.200 liraydı.
Dialogue: 0,0:04:03.59,0:04:06.29,N,,0,0,0,,Brüt kâr yalnızca 4.800 lira.
Dialogue: 0,0:04:06.33,0:04:10.51,N,,0,0,0,,Üstelik kira, fatura ve güvenlik\Ngiderleri henüz düşülmemişti.
Dialogue: 0,0:04:10.99,0:04:12.31,K,,0,0,0,,Olsun... İlk satış bu.
Dialogue: 0,0:04:12.35,0:04:13.48,K,,0,0,0,,Gerisi gelir.
Dialogue: 0,0:04:14.85,0:04:18.33,N,,0,0,0,,İlk ayın sonunda Emir kasaya baktı.
Dialogue: 0,0:04:18.37,0:04:20.03,N,,0,0,0,,183.500 lira.
Dialogue: 0,0:04:20.50,0:04:22.69,K,,0,0,0,,İlk ayda yüz seksen üç bin!
Dialogue: 0,0:04:22.73,0:04:24.14,K,,0,0,0,,Bu iş oluyor!
Dialogue: 0,0:04:24.71,0:04:28.28,N,,0,0,0,,Ama tablonun diğer tarafı\Nbaşka bir şey söylüyordu.
Dialogue: 0,0:04:28.32,0:04:31.05,N,,0,0,0,,Ay, 8.500 lira zararla kapanmıştı.
Dialogue: 0,0:04:31.52,0:04:35.93,N,,0,0,0,,Kasadaki paranın 174.000 lirası,\Ntedarikçiye ödenecek emanet bedeliydi.
Dialogue: 0,0:04:36.60,0:04:38.62,N,,0,0,0,,Emir kasadaki parayı kendi kazancı sandı.
Dialogue: 0,0:04:38.67,0:04:42.16,N,,0,0,0,,Oysa işletmenin gerçek sonucu\Nkasada değil, gelir tablosundaydı.
Dialogue: 0,0:04:42.83,0:04:46.07,N,,0,0,0,,Emir bunu görmedi. Dükkâna\Nışıklı yeni bir tabela,
Dialogue: 0,0:04:46.11,0:04:50.70,N,,0,0,0,,şık bir dekor ve sosyal medya\Nreklamları için 30.000 lira harcadı.
Dialogue: 0,0:04:51.38,0:04:53.86,K,,0,0,0,,İşler iyi gidiyor. Biraz yatırım şart.
Dialogue: 0,0:04:54.53,0:04:56.00,N,,0,0,0,,Sonra ikinci hata geldi.
Dialogue: 0,0:04:56.04,0:04:59.62,N,,0,0,0,,Bir müşteri, düğün seti için\N100.000 liralık sipariş verdi.
Dialogue: 0,0:04:59.66,0:05:02.79,N,,0,0,0,,Emir fiyatı o günün altın\Nfiyatıyla sabitledi.
Dialogue: 0,0:05:03.26,0:05:05.89,N,,0,0,0,,Teslim günü geldiğinde altın yükselmişti.
Dialogue: 0,0:05:05.93,0:05:08.25,N,,0,0,0,,Setin maliyeti 104.000 liraya çıktı.
Dialogue: 0,0:05:08.29,0:05:11.13,N,,0,0,0,,Emir bu satıştan 4.000 lira zarar etti.
Dialogue: 0,0:05:11.80,0:05:14.11,N,,0,0,0,,Ders basitti: Altın\Nfiyatı her gün değişir.
Dialogue: 0,0:05:14.15,0:05:16.73,N,,0,0,0,,Fiyatı bugünden sabitleyip\Naltını yarın alırsan,
Dialogue: 0,0:05:16.77,0:05:18.14,N,,0,0,0,,riski sen taşırsın.
Dialogue: 0,0:05:18.81,0:05:23.37,N,,0,0,0,,İkinci ayın sonunda ciro\N450.000 liraya ulaştı.
Dialogue: 0,0:05:23.41,0:05:26.29,N,,0,0,0,,Kasada 194.500 lira vardı.
Dialogue: 0,0:05:26.76,0:05:31.56,N,,0,0,0,,Ama tedarikçiye ödenecek\Nborç 232.500 liraydı.
Dialogue: 0,0:05:32.13,0:05:33.98,K,,0,0,0,,Ciro artıyor, kasada para var...
Dialogue: 0,0:05:34.02,0:05:36.16,K,,0,0,0,,Ama neden hiçbir şeye yetmiyor?
Dialogue: 0,0:05:36.82,0:05:38.28,N,,0,0,0,,Çünkü ciro, kazanç değildi.
Dialogue: 0,0:05:38.32,0:05:40.85,N,,0,0,0,,Ve kasadaki para, Emir'in parası değildi.
Dialogue: 0,0:05:42.42,0:05:44.53,N,,0,0,0,,Üçüncü ay daha da zor geçti.
Dialogue: 0,0:05:44.57,0:05:47.85,N,,0,0,0,,Altın fiyatları dalgalandı,\Nkâr marjı eridi.
Dialogue: 0,0:05:47.89,0:05:51.45,N,,0,0,0,,Üç ayın toplam zararı\N74.900 liraya ulaştı.
Dialogue: 0,0:05:52.02,0:05:54.50,N,,0,0,0,,Ve bir pazartesi sabahı telefon çaldı.
Dialogue: 0,0:05:54.88,0:05:56.23,K,,0,0,0,,Emir, üç taksit geçti.
Dialogue: 0,0:05:56.27,0:06:00.44,K,,0,0,0,,180.000 lira. Cumaya kadar\Nödemezsen, noterden ihtar çekeceğim.
Dialogue: 0,0:06:01.11,0:06:02.83,N,,0,0,0,,Emir'in dört günü vardı.
Dialogue: 0,0:06:04.50,0:06:05.55,N,,0,0,0,,Salı günü bankaya gitti.
Dialogue: 0,0:06:05.59,0:06:08.52,N,,0,0,0,,Kredi başvurusu, teminat\Nyetersizliği nedeniyle reddedildi.
Dialogue: 0,0:06:09.09,0:06:10.73,N,,0,0,0,,Tedarikçiden süre istemeyi düşündü.
Dialogue: 0,0:06:10.77,0:06:14.27,N,,0,0,0,,Ama emanet bedelini geciktirirse,\Nvitrine bir daha mal gelmeyecekti.
Dialogue: 0,0:06:14.84,0:06:16.89,N,,0,0,0,,Kerem'i aramayı düşündü, vazgeçti.
Dialogue: 0,0:06:16.93,0:06:19.25,N,,0,0,0,,Ona zaten 180.000 lira borçluydu.
Dialogue: 0,0:06:19.82,0:06:22.49,N,,0,0,0,,Kasada 159.100 lira görünüyordu.
Dialogue: 0,0:06:22.53,0:06:26.93,N,,0,0,0,,Ama tedarikçiye 216.000\Nlira ödemesi gerekiyordu.
Dialogue: 0,0:06:27.40,0:06:30.92,N,,0,0,0,,Gerçekte kullanılabilir\Nparası, eksi 56.900 liraydı.
Dialogue: 0,0:06:30.96,0:06:34.89,N,,0,0,0,,Gecikme cezası olarak 8.000\Nlira da gider yazılmıştı.
Dialogue: 0,0:06:35.56,0:06:36.54,K,,0,0,0,,Dükkânı kaybedersem...
Dialogue: 0,0:06:36.58,0:06:38.04,K,,0,0,0,,Babama, Kerem'e ne derim?
Dialogue: 0,0:06:38.91,0:06:40.48,N,,0,0,0,,Emir o gece ilk kez anladı.
Dialogue: 0,0:06:40.52,0:06:43.82,N,,0,0,0,,Bir işletmeyi batıran çoğu\Nzaman satışların azlığı değil,
Dialogue: 0,0:06:43.86,0:06:45.25,N,,0,0,0,,nakdin bitmesiydi.
Dialogue: 0,0:06:47.22,0:06:49.70,N,,0,0,0,,Çarşamba günü kapıdan\Nbeklenmedik biri girdi.
Dialogue: 0,0:06:50.07,0:06:52.31,K,,0,0,0,,Murat Aydın. Bu çarşıda üç dükkânım var.
Dialogue: 0,0:06:52.36,0:06:54.10,K,,0,0,0,,Seni izliyorum delikanlı.
Dialogue: 0,0:06:54.47,0:06:55.81,K,,0,0,0,,Beni mi? Neden?
Dialogue: 0,0:06:56.18,0:06:58.40,K,,0,0,0,,Dükkânın yeri iyi, sen de çalışkansın.
Dialogue: 0,0:06:58.44,0:07:01.36,K,,0,0,0,,Ama paran bitiyor. Bunu\Nbütün çarşı biliyor.
Dialogue: 0,0:07:01.93,0:07:03.11,K,,0,0,0,,400.000 lira koyarım.
Dialogue: 0,0:07:03.15,0:07:05.57,K,,0,0,0,,Karşılığında işletmenin yarısı benim.
Dialogue: 0,0:07:06.24,0:07:08.11,N,,0,0,0,,Dört yüz bine yüzde elli.
Dialogue: 0,0:07:08.15,0:07:12.17,N,,0,0,0,,Yani Murat Bey işletmeye\N800.000 lira değer biçiyordu.
Dialogue: 0,0:07:12.21,0:07:16.42,N,,0,0,0,,Defterlerdeki özkaynak ise\Nyalnızca 215.100 liraydı.
Dialogue: 0,0:07:17.09,0:07:18.52,N,,0,0,0,,Teklif kurtarıcı görünüyordu.
Dialogue: 0,0:07:18.56,0:07:19.70,N,,0,0,0,,Emir kalemi eline aldı.
Dialogue: 0,0:07:19.74,0:07:22.65,N,,0,0,0,,Ama imzalamadan önce\Nmuhasebecisi Ahmet Bey'i aradı.
Dialogue: 0,0:07:23.12,0:07:25.96,K,,0,0,0,,Emir, belgeleri incelerken bir şey buldum.
Dialogue: 0,0:07:26.00,0:07:30.24,K,,0,0,0,,Eski işletmeye ait olduğu iddia\Nedilen 240.000 liralık bir borç
Dialogue: 0,0:07:30.28,0:07:31.38,K,,0,0,0,,talebi var.
Dialogue: 0,0:07:31.85,0:07:34.34,K,,0,0,0,,Ne? Bu borç bana mı geçti?
Dialogue: 0,0:07:34.71,0:07:38.19,K,,0,0,0,,Henüz bilmiyoruz. Devir sözleşmesine\Nve hukuki belgelere bakmamız gerek.
Dialogue: 0,0:07:38.23,0:07:40.27,K,,0,0,0,,Bu belirsizken hiçbir şey imzalama.
Dialogue: 0,0:07:40.84,0:07:43.27,N,,0,0,0,,Bu borcun Emir'e geçip\Ngeçmediği belirsizdi.
Dialogue: 0,0:07:43.31,0:07:46.79,N,,0,0,0,,Bu yüzden tabloya eklenmedi;\Nayrı bir not olarak tutuldu.
Dialogue: 0,0:07:47.36,0:07:48.73,K,,0,0,0,,Murat Bey, teşekkür ederim.
Dialogue: 0,0:07:48.77,0:07:50.23,K,,0,0,0,,Ama şimdi imzalayamam.
Dialogue: 0,0:07:50.70,0:07:53.19,K,,0,0,0,,Kapı her zaman açık kalmaz delikanlı.
Dialogue: 0,0:07:54.06,0:07:55.87,N,,0,0,0,,O akşam Emir bir şeyi anladı:
Dialogue: 0,0:07:55.91,0:07:59.24,N,,0,0,0,,Kurtarıcı görünen her\Nparanın, bir bedeli vardı.
Dialogue: 0,0:08:00.81,0:08:03.38,N,,0,0,0,,Perşembe gecesi Emir\Nsabaha kadar hesap yaptı.
Dialogue: 0,0:08:03.42,0:08:05.99,N,,0,0,0,,Ve iş modelini değiştirmeye karar verdi.
Dialogue: 0,0:08:06.46,0:08:09.33,N,,0,0,0,,Cuma sabahı, son gün,\NHasan Usta'yla oturdu.
Dialogue: 0,0:08:09.70,0:08:11.00,K,,0,0,0,,Usta, ben kaçmıyorum.
Dialogue: 0,0:08:11.04,0:08:13.38,K,,0,0,0,,Ama bu taksitleri bu hâliyle ödeyemem.
Dialogue: 0,0:08:13.42,0:08:16.04,K,,0,0,0,,Bana bir takvim ver, her ay ödeyeyim.
Dialogue: 0,0:08:16.51,0:08:19.95,K,,0,0,0,,Peki evladım. Beş ay onar\Nbin, sonra on beşer bin.
Dialogue: 0,0:08:19.99,0:08:22.07,K,,0,0,0,,Ama gecikmeye faiz işler.
Dialogue: 0,0:08:22.74,0:08:24.84,K,,0,0,0,,Söz usta. Her ay, gününde.
Dialogue: 0,0:08:25.51,0:08:27.03,N,,0,0,0,,Sonra işin kendisini değiştirdi.
Dialogue: 0,0:08:27.07,0:08:29.81,N,,0,0,0,,Vitrinde bekleyen emanet ürün\Nyerine, sipariş üzerine özel
Dialogue: 0,0:08:29.85,0:08:31.46,N,,0,0,0,,tasarımlar yapmaya başladı.
Dialogue: 0,0:08:31.93,0:08:33.63,N,,0,0,0,,Geceleri tasarım programlarını öğrendi.
Dialogue: 0,0:08:33.67,0:08:35.81,N,,0,0,0,,Bir atölye ustasıyla\Nanlaştı; müşteri ne isterse,
Dialogue: 0,0:08:35.85,0:08:37.50,N,,0,0,0,,ölçüsüyle üretmeye başladılar.
Dialogue: 0,0:08:40.47,0:08:43.15,N,,0,0,0,,Müşteri kaporayı veriyor,\Naltın sipariş günü alınıyor,
Dialogue: 0,0:08:43.19,0:08:44.53,N,,0,0,0,,fiyat o gün kilitleniyordu.
Dialogue: 0,0:08:44.57,0:08:46.80,N,,0,0,0,,Böylece altın fiyatı riski azalıyordu.
Dialogue: 0,0:08:47.27,0:08:50.18,N,,0,0,0,,Reklam bütçesini kıstı,\Ngereksiz harcamaları durdurdu.
Dialogue: 0,0:08:50.22,0:08:54.37,N,,0,0,0,,Her akşam kasayı değil; kârı, borcu\Nve nakdi ayrı ayrı saymaya başladı.
Dialogue: 0,0:08:57.94,0:09:00.44,N,,0,0,0,,Dördüncü ay brüt marj yüzde on iki.
Dialogue: 0,0:09:00.48,0:09:02.34,N,,0,0,0,,Beşinci ay yüzde on sekiz.
Dialogue: 0,0:09:02.38,0:09:06.20,N,,0,0,0,,Ve beşinci ayda işletme\Nilk kez aylık kâra geçti.
Dialogue: 0,0:09:06.67,0:09:08.10,N,,0,0,0,,Altıncı ay yüzde yirmi bir.
Dialogue: 0,0:09:08.13,0:09:11.47,N,,0,0,0,,Sekizinci ayda kullanılabilir\Nnakit yeniden artıya döndü.
Dialogue: 0,0:09:11.94,0:09:13.65,N,,0,0,0,,O ay Kerem aradı.
Dialogue: 0,0:09:14.02,0:09:16.45,K,,0,0,0,,Kardeşim, o para bana yıl sonunda lazım.
Dialogue: 0,0:09:16.49,0:09:18.05,K,,0,0,0,,Unutmadın, değil mi?
Dialogue: 0,0:09:18.52,0:09:20.62,K,,0,0,0,,Unutmadım Kerem. Elimden geleni yapacağım.
Dialogue: 0,0:09:21.39,0:09:23.67,N,,0,0,0,,Artık her müşteriye\Ntek bir soru soruyordu:
Dialogue: 0,0:09:23.71,0:09:25.80,N,,0,0,0,,Hayalinizdeki parça nasıl olmalı?
Dialogue: 0,0:09:29.38,0:09:31.67,N,,0,0,0,,Bir müşteri, nişan yüzüğünün\Nfotoğrafını paylaştı.
Dialogue: 0,0:09:31.71,0:09:33.79,N,,0,0,0,,Sonra bir başkası. Siparişler çoğaldı.
Dialogue: 0,0:09:34.26,0:09:35.39,N,,0,0,0,,Emir hâlâ borçluydu.
Dialogue: 0,0:09:35.43,0:09:39.44,N,,0,0,0,,Ama artık neyin kâr, neyin borç,\Nneyin emanet olduğunu biliyordu.
Dialogue: 0,0:09:44.01,0:09:47.65,N,,0,0,0,,On ikinci ayın sonunda Emir,\Nmuhasebecisiyle yılın hesabını kapattı.
Dialogue: 0,0:09:48.12,0:09:50.22,K,,0,0,0,,Toplam satış: 4 milyon lira.
Dialogue: 0,0:09:50.59,0:09:51.54,K,,0,0,0,,Dört milyon!
Dialogue: 0,0:09:51.91,0:09:55.62,K,,0,0,0,,Dur, heyecanlanma. Satılan\Nürünlerin maliyeti 3,2 milyon.
Dialogue: 0,0:09:55.66,0:09:58.72,K,,0,0,0,,Kira, faturalar, güvenlik,\Nkomisyonlar, reklam,
Dialogue: 0,0:09:58.76,0:10:00.55,K,,0,0,0,,faiz ve vergi: 560.000
Dialogue: 0,0:10:01.02,0:10:03.89,K,,0,0,0,,Net kâr: 240.000 lira.
Dialogue: 0,0:10:04.56,0:10:08.80,N,,0,0,0,,Dört milyon liralık satış, Emir'in dört\Nmilyon kazandığı anlamına gelmiyordu.
Dialogue: 0,0:10:08.84,0:10:12.05,N,,0,0,0,,Bir yılın karşılığı, iki\Nyüz kırk bin liralık kârdı.
Dialogue: 0,0:10:12.62,0:10:14.71,N,,0,0,0,,Nakit tarafında tablo netti.
Dialogue: 0,0:10:14.75,0:10:16.83,N,,0,0,0,,Yılı 18.000 lirayla açmıştı.
Dialogue: 0,0:10:16.87,0:10:18.30,N,,0,0,0,,240.000 kâr ekledi.
Dialogue: 0,0:10:18.34,0:10:23.19,N,,0,0,0,,Satıcıya ve Kerem'e toplam\N130.000 lira borç anaparası ödedi.
Dialogue: 0,0:10:23.66,0:10:25.17,N,,0,0,0,,Borç ödemek gider değildi.
Dialogue: 0,0:10:25.21,0:10:28.45,N,,0,0,0,,Kârı azaltmadı ama kasadan\Nçıktı ve borcu azalttı.
Dialogue: 0,0:10:28.92,0:10:31.89,N,,0,0,0,,Yıl sonunda kasada 128.000 lira vardı.
Dialogue: 0,0:10:31.93,0:10:34.59,N,,0,0,0,,Kalan toplam borç 490.000 liraydı.
Dialogue: 0,0:10:34.63,0:10:39.10,N,,0,0,0,,İşletmedeki özkaynağı ise\N530.000 liraya yükselmişti.
Dialogue: 0,0:10:39.77,0:10:43.94,N,,0,0,0,,Kalan borcun 250.000 lirası\Nsatıcıya, 160.000 lirası Kerem'e,
Dialogue: 0,0:10:43.98,0:10:45.77,N,,0,0,0,,80.000 lirası ailesineydi.
Dialogue: 0,0:10:45.81,0:10:49.57,N,,0,0,0,,Kerem'e bu yıl yalnızca\N20.000 lira ödeyebilmişti.
Dialogue: 0,0:10:50.24,0:10:53.88,N,,0,0,0,,Ahmet Bey dosyayı kapatmadan\Nönce bir şey daha söyledi.
Dialogue: 0,0:10:54.25,0:10:57.28,K,,0,0,0,,O 240.000 liralık talep hâlâ duruyor Emir.
Dialogue: 0,0:10:57.32,0:11:00.97,K,,0,0,0,,Avukat inceliyor. Ama\Nhenüz kimse dava açmadı.
Dialogue: 0,0:11:01.74,0:11:06.15,N,,0,0,0,,Bir yıl önce kasaya bakıp sevinen\NEmir, artık önce defterine bakıyordu.
Dialogue: 0,0:11:06.72,0:11:11.13,N,,0,0,0,,Basit bir tablo. Ama bir yıl önce\Nbilmediği her şeyi anlatıyordu.
Dialogue: 0,0:11:14.90,0:11:16.34,K,,0,0,0,,Teklifim hâlâ geçerli.
Dialogue: 0,0:11:16.38,0:11:17.77,K,,0,0,0,,2,5 milyon lira.
Dialogue: 0,0:11:18.34,0:11:23.90,N,,0,0,0,,Emir hesap yaptı. Satış gerçekleşirse\Nönce kalan 490.000 lira borcu kapatacaktı.
Dialogue: 0,0:11:24.38,0:11:26.88,N,,0,0,0,,Kasadaki 128.000 lira da onundu.
Dialogue: 0,0:11:26.92,0:11:33.40,N,,0,0,0,,Vergi, komisyon ve masraflardan önce\Neline yaklaşık 2.138.000 lira geçebilirdi.
Dialogue: 0,0:11:33.87,0:11:38.88,N,,0,0,0,,Ama o 240.000 liralık\Nbelirsiz talep haklı çıkarsa,
Dialogue: 0,0:11:38.92,0:11:42.13,N,,0,0,0,,bu rakam 1.898.000 düşecekti.
Dialogue: 0,0:11:42.70,0:11:44.79,N,,0,0,0,,Satarsa bütün borçlarından kurtulacaktı.
Dialogue: 0,0:11:44.83,0:11:47.38,N,,0,0,0,,Satmazsa, bir yılda kurduğu\Ndüzeni büyütebilirdi.
Dialogue: 0,0:11:47.42,0:11:50.57,N,,0,0,0,,Ama Kerem'in 160.000 lirası\Nda yakında lazım olacaktı.
Dialogue: 0,0:11:51.14,0:11:53.62,N,,0,0,0,,Bir yıl önce 85.000 lirası vardı.
Dialogue: 0,0:11:53.65,0:11:56.32,N,,0,0,0,,Şimdi önünde iki yol duruyordu.
Dialogue: 0,0:11:56.89,0:11:58.22,K,,0,0,0,,Ne diyorsun Emir?
Dialogue: 0,0:11:59.09,0:11:59.99,N,,0,0,0,,Emir dükkâna baktı.
Dialogue: 0,0:12:00.03,0:12:01.76,N,,0,0,0,,Vitrinlere, borç defterine, kasaya...
Dialogue: 0,0:12:01.80,0:12:03.50,N,,0,0,0,,Ve camdaki kendi yansımasına.
Dialogue: 0,0:12:04.58,0:12:05.14,K,,0,0,0,,Ben...
